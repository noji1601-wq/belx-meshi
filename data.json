    {
      "name": "豚ロース生姜焼き",
      "minutes": 15,
      "uses": [
        "豚ロース生姜焼用",
        "玉ねぎ"
      ],
      "reason": "朝市の99円/100gロースで作る定番。ご飯が進みます。",
      "ingredients": [
        "豚ロース生姜焼用 250g",
        "玉ねぎ 1/2個",
        "しょうが（すりおろし） 1かけ",
        "醤油 大さじ1.5",
        "みりん 大さじ1",
        "酒 大さじ1",
        "砂糖 小さじ1",
        "キャベツ 2〜3枚（千切り）",
        "油 小さじ1"
      ],
      "steps": [
        "玉ねぎは薄切り、キャベツは千切りにする。",
        "醤油・みりん・酒・砂糖・しょうがを混ぜてたれを作る。",
        "フライパンに油を熱し、豚ロースを両面焼く。",
        "玉ねぎを加えて炒め、しんなりしたらたれを回しかけて煮絡める。",
        "キャベツを添えて盛り付ける。"
      ]
    },
    {
      "name": "鶏むねと厚揚げのねぎ甘辛炒め",
      "minutes": 20,
      "uses": [
        "若鶏ムネ肉",
        "絹厚揚げ",
        "長ねぎ"
      ],
      "reason": "79円のムネ肉と88円の厚揚げでボリューム満点・節約おかず。",
      "ingredients": [
        "若鶏ムネ肉 1枚（約250g）",
        "絹厚揚げ 2枚",
        "長ねぎ 1本",
        "片栗粉 大さじ1",
        "醤油 大さじ1.5",
        "みりん 大さじ1.5",
        "砂糖 小さじ1",
        "酒 大さじ1",
        "油 大さじ1"
      ],
      "steps": [
        "ムネ肉はそぎ切りにして酒小さじ1と片栗粉をもみ込む。",
        "厚揚げは一口大、長ねぎは斜め切りにする。",
        "フライパンに油を熱し、ムネ肉を両面焼いて火を通す。",
        "厚揚げとねぎを加えて炒める。",
        "醤油・みりん・砂糖・酒を加え、とろみがつくまで煮絡める。"
      ]
    },
    {
      "name": "豚こまとじゃがいもの具だくさん味噌汁",
      "minutes": 15,
      "uses": [
        "豚こま切れ",
        "じゃがいも",
        "玉ねぎ",
        "長ねぎ"
      ],
      "reason": "豚こま・じゃがいも・玉ねぎ・ねぎを使い切れる、食べる味噌汁。",
      "ingredients": [
        "豚こま切れ 100g",
        "じゃがいも 1個",
        "玉ねぎ 1/2個",
        "長ねぎ 1本",
        "水 400ml",
        "鶏がらスープの素 小さじ1",
        "味噌 大さじ1.5",
        "ごま油 小さじ1"
      ],
      "steps": [
        "じゃがいもは一口大、玉ねぎはくし切り、長ねぎは小口切りにする。",
        "鍋にごま油を熱し、豚こまを炒める。",
        "じゃがいもと玉ねぎを加えて軽く炒め、水と鶏がらスープの素を入れる。",
        "じゃがいもが柔らかくなるまで10分ほど煮る。",
        "味噌を溶き入れ、長ねぎを加えてひと煮立ちさせる。"
