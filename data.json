  "recipes": [
    {
      "name": "豚ロース生姜焼き キャベツ添え",
      "minutes": 15,
      "uses": [
        "豚ロース生姜焼用",
        "キャベツ",
        "玉ねぎ"
      ],
      "reason": "朝市の99円/100gの生姜焼用肉を使った、安くてご飯が進む定番の主菜です。",
      "ingredients": [
        "豚ロース生姜焼用 250g",
        "玉ねぎ 1/2個",
        "キャベツ 1/4個(千切り用)",
        "おろし生姜 小さじ2",
        "醤油 大さじ2",
        "みりん 大さじ2",
        "酒 大さじ1",
        "砂糖 小さじ1",
        "油 少々"
      ],
      "steps": [
        "醤油・みりん・酒・砂糖・生姜を混ぜてたれを作る。玉ねぎは薄切り、キャベツは千切りにする。",
        "フライパンに油を熱し、豚肉を広げて入れ、両面に焼き色がつくまで焼く。",
        "玉ねぎを加えてしんなりするまで炒める。",
        "たれを回し入れ、全体にからめて照りが出たら火を止める。",
        "皿にキャベツを盛り、生姜焼きをのせる。"
      ]
    },
    {
      "name": "かぼちゃと鶏ひき肉のそぼろ煮",
      "minutes": 20,
      "uses": [
        "かぼちゃ",
        "若鶏ムネ挽肉"
      ],
      "reason": "かぼちゃは100g29円、ムネ挽肉は88円と、どちらも安い食材でできる主菜です。",
      "ingredients": [
        "かぼちゃ 1/4個(約350g)",
        "若鶏ムネ挽肉 150g",
        "水 250ml",
        "顆粒和風だし 小さじ1",
        "醤油 大さじ1と1/2",
        "みりん 大さじ2",
        "砂糖 小さじ2",
        "酒 大さじ1",
        "片栗粉 小さじ2(水大さじ1で溶く)"
      ],
      "steps": [
        "かぼちゃは種とわたを取り、3cm角に切る。",
        "鍋に水・だし・酒・みりん・砂糖・醤油を入れて煮立て、挽肉を加えてほぐしながら煮る。",
        "アクを取り、かぼちゃを皮を下にして並べ、落とし蓋をして中火で10〜12分煮る。",
        "かぼちゃがやわらかくなったら、水溶き片栗粉を回し入れてとろみをつける。"
      ]
    },
    {
      "name": "厚揚げとキャベツの味噌汁",
      "minutes": 10,
      "uses": [
        "絹厚揚げ",
        "キャベツ"
      ],
      "reason": "厚揚げ88円とキャベツを使い、ボリュームのある汁物が手早く作れます。",
      "ingredients": [
        "絹厚揚げ 1枚",
        "キャベツ 2〜3枚",
        "水 400ml",
        "顆粒和風だし 小さじ1",
        "味噌 大さじ1と1/2"
      ],
      "steps": [
        "厚揚げは熱湯をかけて油抜きし、一口大に切る。キャベツはざく切りにする。",
        "鍋に水とだしを入れて煮立て、キャベツと厚揚げを入れる。",
        "キャベツがやわらかくなるまで3〜4分煮る。",
        "火を弱めて味噌を溶き入れ、煮立つ直前に火を止める。"
      ]
    }
  ],
